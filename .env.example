# Copy to .env and fill in. Real environment variables take priority over this file.

# Core's REST API base URL (Core's default API port is 3001; use your SERVER_PORT)
API_BASE_URL=http://127.0.0.1:3001/api
# Organization API key or personal access token, sent as 'Authorization: Bearer <token>'.
# Read-only use: grant the key only read permissions.
API_TOKEN=

# Optional defaults so the triage tools can be called without arguments (slugs are not secrets)
CORE_ORG=
CORE_PROJECT=
CORE_ENVIRONMENT=dev

# Seconds to wait for a response (default 30) and for a connection (default 10)
API_TIMEOUT=30
# Responses longer than this many characters are truncated with a notice (generated tools)
MAX_RESPONSE_CHARS=20000
LOG_LEVEL=INFO

# Transport: stdio (default) or streamable-http
# MCP_ENV_FILE=/path/to/other.env   # read settings from this file instead of ./.env
# MCP_TRANSPORT=stdio
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
